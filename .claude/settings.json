{
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "aiup-core@ai-unified-process-marketplace": true
 },
 "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"$HOME/.volta/bin:$PATH\"; npm run format",
            "timeout": 60,
            "statusMessage": "Formatting source (prettier)…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"$HOME/.volta/bin:$PATH\"; npm run check && npm test",
            "timeout": 300,
            "statusMessage": "Running full CI suite (lint, format check, audit, tests)…"
          }
        ]
      }
    ]
  }
}
