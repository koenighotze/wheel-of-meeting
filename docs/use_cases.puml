@startuml Use Cases Overview
left to right direction

actor "User" as user

rectangle "Wheel of Meeting" {
    usecase "UC-001\nSwitch Dataset" as UC001
    usecase "UC-002\nSpin the Wheel for an Invitee" as UC002
    usecase "UC-003\nSchedule a 1:1 Meeting" as UC003
    usecase "UC-004\nReview Meeting History" as UC004
    usecase "UC-005\nClear Meeting History" as UC005
}

user --> UC001
user --> UC002
user --> UC003
user --> UC004
user --> UC005

UC001 ..> UC004 : <<include>>
UC002 ..> UC004 : <<include>>
UC005 ..> UC004 : <<include>>

@enduml
