{
  "name": "wheel-of-meeting",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite-plus": "1.7.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "vp lint",
