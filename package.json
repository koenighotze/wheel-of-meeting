    "audit": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm run format:check && npm run audit"
  },
  "packageManager": "npm@12.0.1",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
